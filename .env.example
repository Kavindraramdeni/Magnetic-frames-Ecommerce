# KRIA Studio Luxury E-Commerce Environment Configuration

# Admin Operations Console Security
ADMIN_PASSWORD=your_admin_password_here
ADMIN_TOKEN=your_secure_bearer_token_here

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
ENABLE_MOCK_CHECKOUT=false

# Logistics & Courier Dispatch (Shiprocket)
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_PINCODE=500085

# Cloud Database & Storage (Supabase PostgreSQL)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_public_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key

# Marketing & Analytics Attribution
VITE_META_PIXEL_ID=your_meta_pixel_id
VITE_GA_MEASUREMENT_ID=your_ga4_measurement_id

# Rate Limiting & Network
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
ALLOWED_ORIGINS=https://yourdomain.com,https://your-vercel-app.vercel.app
