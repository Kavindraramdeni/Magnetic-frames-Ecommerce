{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/stored-assets/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api|stored-assets).*)",
      "destination": "/index.html"
    }
  ]
}
